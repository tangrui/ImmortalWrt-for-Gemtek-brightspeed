#!/bin/sh
# No preference resets: restored network, wireless, IPv6, theme and app switches win.
. /lib/functions/personal-upgrade.sh
mode=$(cat /tmp/personal-upgrade/mode 2>/dev/null) || exit 1
case "$mode" in
factory|configured|upgrade-preserve) ;;
*) echo 'Personal migrations deferred: configuration restore did not succeed.' >&2; exit 1 ;;
esac
# Programs follow the new firmware. Subscription/configuration files are untouched.
personal_refresh_bundled_core || exit 1
personal_migrate_orphan_includes_v1 || exit 1
exit 0
